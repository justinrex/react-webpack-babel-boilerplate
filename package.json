{
  "name": "react-webpack-babel-boilerplate",
  "version": "0.1.0",
  "description": "React and TypeScript starter with Webpack, Babel, and Jest.",
  "scripts": {
    "dev": "webpack serve --mode development",
    "start": "npm run dev",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "npm run typecheck && npm test -- --runInBand && npm run build"
  },
  "keywords": [
    "webpack"
  ],
  "author": "justin rex",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.0.0",
    "@babel/preset-react": "^7.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "typescript": "~5.9.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
